# Application
APP_NAME="Bat-Board API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For development: sqlite:///./batboard.db
# For production: postgresql+asyncpg://user:password@host:5432/batboard
DATABASE_URL=sqlite:///./batboard.db

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://yourdomain.com"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Telegram bot (Phase 2A — set in Railway dashboard before enabling webhook)
# TELEGRAM_BOT_TOKEN comes from @BotFather on Telegram (never commit the real value)
TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET is a separate random string YOU generate (not from Telegram).
# It proves incoming webhook requests actually came from Telegram.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=

# LLM (Phase 2B — Alfred; unused for now)
GEMINI_API_KEY=
# Per-user provider keys (BYOK) — Fernet derivation secret. Generate with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# App refuses to boot without it (same fail-loudly pattern as SECRET_KEY).
PROVIDER_KEY_ENCRYPTION_SECRET=
